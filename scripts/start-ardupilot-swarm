#!/usr/bin/env bash

set -Eeuo pipefail

CONFIG_FILE="/etc/ardupilot-swarm/ardupilot-swarm.conf"
SESSION_CREATED=false

cleanup() {
  local status=$?
  trap - EXIT

  if (( status != 0 )) && [[ "${SESSION_CREATED}" == "true" ]]; then
    tmux kill-session -t "${SESSION_NAME}" 2>/dev/null || true
  fi

  exit "${status}"
}
trap cleanup EXIT

if [[ ! -r "${CONFIG_FILE}" ]]; then
  echo "Missing configuration file: ${CONFIG_FILE}" >&2
  exit 1
fi

# shellcheck source=/dev/null
source "${CONFIG_FILE}"

SIM_VEHICLE="${ARDUPILOT_DIR}/Tools/autotest/sim_vehicle.py"
LOG_DIR="${RUN_HOME}/.local/state/ardupilot-swarm"

export HOME="${RUN_HOME}"
export PATH="${RUN_HOME}/.local/bin:${ARDUPILOT_DIR}/Tools/autotest:${PATH}"
export PYTHONUNBUFFERED=1

activate_ardupilot_venv() {
  local candidate
  local candidates=(
    "${ARDUPILOT_DIR}/venv-ardupilot"
    "${ARDUPILOT_DIR}/venv"
    "${ARDUPILOT_DIR}/.venv"
    "${RUN_HOME}/venv-ardupilot"
  )

  for candidate in "${candidates[@]}"; do
    if [[ -x "${candidate}/bin/python3" ]]; then
      export VIRTUAL_ENV="${candidate}"
      export PATH="${candidate}/bin:${PATH}"
      unset PYTHONHOME || true
      echo "Using ArduPilot Python environment: ${candidate}"
      return 0
    fi
  done

  echo "No ArduPilot Python virtual environment was found; using system Python."
}

validate_swarm_config() {
  local count="${#SYSTEM_IDS[@]}"

  if (( count == 0 )); then
    echo "The swarm configuration contains no vehicles." >&2
    exit 1
  fi

  if (( ${#WINDOW_NAMES[@]} != count ||
        ${#INSTANCE_NUMBERS[@]} != count ||
        ${#ROUTER_PORTS[@]} != count ||
        ${#HOME_LATITUDES[@]} != count ||
        ${#HOME_LONGITUDES[@]} != count )); then
    echo "Swarm configuration arrays must contain the same number of entries." >&2
    exit 1
  fi
}

validate_swarm_config
activate_ardupilot_venv
mkdir -p "${LOG_DIR}"

if [[ "${VEHICLE_TYPE}" != "ArduPlane" || "${VEHICLE_FRAME}" != "plane" ]]; then
  echo "This package requires ArduPlane firmware with the fixed-wing plane frame." >&2
  exit 1
fi

if [[ ! -d "${ARDUPILOT_DIR}" ]]; then
  echo "Missing ArduPilot directory: ${ARDUPILOT_DIR}" >&2
  exit 1
fi

if [[ ! -f "${SIM_VEHICLE}" ]]; then
  echo "Missing ArduPilot simulator launcher: ${SIM_VEHICLE}" >&2
  exit 1
fi

if [[ ! -r "${PARAM_FILE}" ]]; then
  echo "Missing or unreadable ArduPilot parameter file: ${PARAM_FILE}" >&2
  echo "Install it with: sudo ardupilot-swarm-install-parameters /path/to/file.parm" >&2
  exit 1
fi

if ! command -v tmux >/dev/null 2>&1; then
  echo "tmux is not installed or is not available in PATH" >&2
  exit 1
fi

if tmux has-session -t "${SESSION_NAME}" 2>/dev/null; then
  echo "ArduPilot swarm is already running in tmux session: ${SESSION_NAME}"
  exit 0
fi

build_command() {
  local index="$1"
  local location="${HOME_LATITUDES[$index]},${HOME_LONGITUDES[$index]},${HOME_ALT},${HOME_HEADING}"
  local command=(
    "${SIM_VEHICLE}"
    -v "${VEHICLE_TYPE}"
    -f "${VEHICLE_FRAME}"
    --no-rebuild
    --instance "${INSTANCE_NUMBERS[$index]}"
    --sysid "${SYSTEM_IDS[$index]}"
  )

  if [[ "${WIPE_PARAMETERS}" == "true" ]]; then
    command+=(-w)
  fi

  command+=(
    "--add-param-file=${PARAM_FILE}"
    "--custom-location=${location}"
    "--out=udp:${ROUTER_ADDRESS}:${ROUTER_PORTS[$index]}"
  )

  printf '%q ' "${command[@]}"
}

start_vehicle() {
  local index="$1"
  local window_name="${WINDOW_NAMES[$index]}"
  local log_file="${LOG_DIR}/${window_name}.log"
  local tmux_command

  : > "${log_file}"
  tmux_command="$(build_command "${index}")"
  tmux_command+=" >> $(printf '%q' "${log_file}") 2>&1"

  if (( index == 0 )); then
    tmux new-session \
      -d \
      -s "${SESSION_NAME}" \
      -n "${window_name}" \
      -c "${ARDUPILOT_DIR}" \
      "sleep infinity"
    SESSION_CREATED=true
  else
    tmux new-window \
      -d \
      -t "${SESSION_NAME}" \
      -n "${window_name}" \
      -c "${ARDUPILOT_DIR}" \
      "sleep infinity"
  fi

  tmux set-window-option -t "${SESSION_NAME}:${window_name}" remain-on-exit on
  tmux respawn-pane -k -t "${SESSION_NAME}:${window_name}" "${tmux_command}"

  echo "Started ${window_name}:"
  echo "  firmware:    ${VEHICLE_TYPE}"
  echo "  frame:       ${VEHICLE_FRAME}"
  echo "  instance:    ${INSTANCE_NUMBERS[$index]}"
  echo "  system ID:   ${SYSTEM_IDS[$index]}"
  echo "  router port: ${ROUTER_PORTS[$index]}"
  echo "  location:    ${HOME_LATITUDES[$index]},${HOME_LONGITUDES[$index]}"
  echo "  log:         ${log_file}"
}

verify_vehicle_startup() {
  local index
  local window_name
  local log_file
  local pane_dead
  local failed=0

  sleep 5

  for index in "${!SYSTEM_IDS[@]}"; do
    window_name="${WINDOW_NAMES[$index]}"
    log_file="${LOG_DIR}/${window_name}.log"
    pane_dead="$(tmux display-message -p -t "${SESSION_NAME}:${window_name}" '#{pane_dead}')"

    if [[ "${pane_dead}" == "1" ]]; then
      echo "${window_name} exited during startup. Recent output:" >&2
      tail -n 80 "${log_file}" >&2 || true
      failed=1
    fi
  done

  if (( failed != 0 )); then
    echo "One or more ArduPlane SITL vehicles failed to stay running." >&2
    echo "Full logs are under: ${LOG_DIR}" >&2
    exit 1
  fi
}

for index in "${!SYSTEM_IDS[@]}"; do
  start_vehicle "${index}"
done

verify_vehicle_startup
trap - EXIT

echo
echo "Started ${#SYSTEM_IDS[@]} ArduPlane fixed-wing SITL vehicles."
echo "tmux session: ${SESSION_NAME}"
echo "Parameters loaded from: ${PARAM_FILE}"
echo "Logs: ${LOG_DIR}"
echo "Attach with: tmux attach -t ${SESSION_NAME}"
